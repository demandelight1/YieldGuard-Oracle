PORT=3000
CELO_RPC_URL=https://forno.celo.org
YIELDGUARD_AGENT_ADDRESS=0xf171D36B8E89566eD86e162F07289980A5c2970f
CELO_ATTRIBUTION_TAG=celo_6e7b9c9d8084
# Canonical ERC-8004 Identity Registry on Celo mainnet.
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# Celo USDC. $0.04 is 40,000 atomic units (6 decimals).
CELO_USDC_ADDRESS=0xcebA9300f2b948710d2653dD7B07f33A8B32118C
REPORT_PRICE_USDC=0.04
# Set true in a deployed environment. Keep false while iterating locally.
REQUIRE_CONSUMER_PAYMENT=false
ENABLE_LIVE_UPSTREAMS=false
UPSTREAM_MAX_USD=0.03
# Server-side Buy/x402 settings. BUY_IMPORT_KEY is a Render secret only.
BUY_ACCOUNT=yieldguard-oracle
BUY_DAILY_SPEND_CAP_USDC=1.00
BUY_IMPORT_KEY=
# Used only by one-off local agent scripts. Never add this to Render.
AGENT_PRIVATE_KEY=
